# Modified by Tianyu (Sky) Lu in 2026: removed the Windows branch of the bundling script.

OS_TYPE="$(uname -s)"

if [[ "$OS_TYPE" = "Darwin" ]]; then
  ./script/macos/bundle "$@"
elif [[ "$OS_TYPE" = "Linux" ]]; then
  ./script/linux/bundle "$@"
else
  echo "No bundle script defined for the current platform ($OS_TYPE)!"
  exit 1
fi
